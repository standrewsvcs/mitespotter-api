# deploy/dev.env.example
# Settings for the public dev server: copy to deploy/dev.env (gitignored, chmod 600) and fill in.
# Read by both systemd (EnvironmentFile=) and uv (--env-file): plain KEY=value, no quotes, no export.

# prod even though it's the dev server: it is on the public internet, so no debug tracebacks,
# no auto-reload, and the secret key and Resend become required
MITESPOTTER_ENV=prod
MITESPOTTER_DEBUG=false
MITESPOTTER_SQL_ECHO=false

# Loopback only: cloudflared is the only way in. Must match the service in /etc/cloudflared/config.yml
MITESPOTTER_HOST=127.0.0.1
MITESPOTTER_PORT=6776

# Signs CSRF tokens and keys email-code HMACs; changing it invalidates open codes.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MITESPOTTER_SECRET_KEY=

# A database of its own, not your development one
MITESPOTTER_DATABASE_URL=postgresql+psycopg://mitespotter_dev:<password>@localhost/mitespotter_dev

# The tunnel hostname. https makes cookies Secure; Google's redirect URI is <this>/api/auth/google/callback
MITESPOTTER_PUBLIC_URL=https://dev.mitespotter.org

# Local disk for now (R2 later). Defaults to data/ in the checkout
MITESPOTTER_STORAGE=local
# MITESPOTTER_DATA_DIR=

# Resend. Until a domain is verified in Resend, send from onboarding@resend.dev:
# Resend then only delivers to the Resend account owner's own address
MITESPOTTER_MAILER=resend
MITESPOTTER_RESEND_API_KEY=
MITESPOTTER_EMAIL_FROM=onboarding@resend.dev

# Google sign-in (Web application client); leave both empty to disable it
MITESPOTTER_GOOGLE_CLIENT_ID=
MITESPOTTER_GOOGLE_CLIENT_SECRET=

# Developer test page at /api/dev: off by default in prod, on for the team's dev server; off before launch
MITESPOTTER_DEV_PAGE=true
