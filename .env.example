# .env.example
# Developer defaults, except for the database URL, which must be set.
#
# Created: 2026-09-18
# Authors: Maxence Morel Dierckx

MITESPOTTER_ENV=dev
MITESPOTTER_DEBUG=True
MITESPOTTER_HOST=127.0.0.1
MITESPOTTER_PORT=6776
MITESPOTTER_SECRET_KEY=dev-secret-key
MITESPOTTER_DATABASE_URL=REPLACE_URL
MITESPOTTER_SQL_ECHO=True

# Storage: `local` writes under MITESPOTTER_DATA_DIR (default ./data); `r2` needs the R2 settings
MITESPOTTER_STORAGE=local
MITESPOTTER_PUBLIC_DATA_URL=/data
# MITESPOTTER_R2_ACCOUNT_ID=
# MITESPOTTER_R2_BUCKET=mitespotter-data
# MITESPOTTER_R2_ACCESS_KEY_ID=
# MITESPOTTER_R2_SECRET_ACCESS_KEY=

# Public address of the site; https makes cookies Secure
MITESPOTTER_PUBLIC_URL=http://127.0.0.1:6776

# Email: `outbox` logs emails (dev); `resend` sends them and is required in prod
MITESPOTTER_MAILER=outbox
# MITESPOTTER_RESEND_API_KEY=
# MITESPOTTER_EMAIL_FROM=Mitespotter <noreply@mitespotter.org>

# Google sign-in: both set to enable; redirect URI is <public url>/api/auth/google/callback
# MITESPOTTER_GOOGLE_CLIENT_ID=
# MITESPOTTER_GOOGLE_CLIENT_SECRET=

# Tests only: a Postgres server the test suite may create and drop databases on
# MITESPOTTER_TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost/postgres
